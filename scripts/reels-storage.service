[Unit]
Description=Mashhad private reels storage HTTPS upstream
After=network-online.target
[Service]
User=mashhad
Group=mashhad
WorkingDirectory=/opt/mashhad/reels/current
EnvironmentFile=/etc/mashhad/reels-storage.env
ExecStart=/usr/local/bin/node /opt/mashhad/reels/current/worker/dist/reels-storage-server.js
Restart=on-failure
RestartSec=10
UMask=0077
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mashhad-reels
[Install]
WantedBy=multi-user.target
