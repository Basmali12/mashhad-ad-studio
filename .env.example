# Public frontend configuration only; Development deployment, never Production.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_CLERK_PUBLISHABLE_KEY=
# Convex CLI writes this after you select your Development project.
CONVEX_DEPLOYMENT=
# Set SERVER variables in the Convex Development dashboard, NOT with VITE_:
# CLERK_JWT_ISSUER_DOMAIN=https://your-dev-instance.clerk.accounts.dev
# OWNER_SUBJECT=your_clerk_user_id
# CLIENT_ORIGINS=http://127.0.0.1:43130,http://localhost:43130
# OPENAI_API_KEY: set privately in the Convex Development dashboard only.
# Never prefix it with VITE_ or put its value in this file.
# Never add CLERK_SECRET_KEY, Google credentials, cookies, or deploy keys here.
