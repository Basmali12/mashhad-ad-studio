{
  "name": "personal-ad-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43130 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "worker:setup": "node scripts/setup-worker.mjs",
    "worker:login": "npm --prefix worker run login",
    "worker:inspect": "npm --prefix worker run inspect",
    "worker:review": "npm --prefix worker run review --",
    "worker:run": "npm --prefix worker run run --",
    "worker:resume": "npm --prefix worker run resume --",
    "worker:reupload": "npm --prefix worker run reupload --",
    "worker:status": "npm --prefix worker run service:status",
    "worker:stop": "npm --prefix worker run service:stop",
    "montage:check": "npm --prefix worker run montage:check --",
    "montage:run": "npm --prefix worker run montage:run --",
    "montage:resume": "npm --prefix worker run montage:resume --",
    "montage:reupload": "npm --prefix worker run montage:reupload --",
    "montage:watch": "npm --prefix worker run montage:watch --",
    "montage:status": "npm --prefix worker run montage:status --",
    "montage:stop": "npm --prefix worker run montage:stop --",
    "worker:start": "npm --prefix worker run service:start --"
  },
  "dependencies": {
    "@clerk/localizations": "^4.21.2",
    "@clerk/react": "^6.17.5",
    "convex": "^1.46.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "convex-test": "^0.0.60",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  }
}
