# Dedicated film service. These defaults do not enable paid/customer execution.
CUSTOMER_PLATFORM_ENABLED=NO
ENGINE_ALLOW_PAID_ACTIONS=NO
# FLUX has a separate opt-in; keep NO until explicit model preparation/testing approval.
FILM_FLUX_PAID_ENABLED=NO
# ENGINE_TEXT_QC_PYTHON= (absolute isolated CPU Python executable)
# ENGINE_TEXT_DETECTOR_MODEL= (pre-provisioned hash-verified Tiny ONNX file)
# ENGINE_FFMPEG_BIN= (existing local CPU binary)
ENGINE_DATABASE_DRIVER=sqlite
FILM_DEDICATED_DATA_CONFIRMED=NO
# FILM_DATA_DIR must be a NEW absolute, dedicated path outside historical service data.
# FILM_DATA_DIR=
# FILM_DEPLOYMENT_ID=film-platform-staging-unique-id
# ENGINE_MASTER_KEY= (new base64 32-byte vault key, provision out of band)
# FILM_BRIDGE_SECRET= (different >=32-character random shared server secret)
# FILM_PUBLIC_ORIGIN=https://film-engine.example.invalid
# FILM_MEDIA_ORIGINS=https://studio.example.invalid
FILM_PORT=3477
FILM_LEGACY_ADMIN_ENABLED=NO
FILM_TEXT_ENABLED=NO
FILM_TEXT_ADMIN_BUDGET_MICRO_USD=0
# PostgreSQL requires an explicitly approved separate database named film_platform_*.
# ENGINE_DATABASE_NAME=film_platform_staging
# ENGINE_DATABASE_USER=film_platform_app
# ENGINE_DATABASE_PASSWORD_FILE=
# FILM_TLS_CERT_FILE=
# FILM_TLS_KEY_FILE=

# FILM_FFMPEG_PATH= (existing local CPU binary; no auto download)
# FILM_FFPROBE_PATH= (preferred; missing binary uses real FFmpeg full decode)

# Retained original reference bytes per customer, including replacements/unlinks.
# Reserve4,000,000 bytes per in-flight upload; valid range4,000,000..10GiB.
FILM_REFERENCE_CUSTOMER_LIMIT_BYTES=67108864

# CPU transfer worker must be separately approved/deployed with the SAME inference profile.
# ENGINE_CLOUD_TRANSFER_APP=mashhad-model-cloud-copy-v1

# Qwen software integration only; enable solely after a separately approved cloud preparation/test.
FILM_QWEN_PAID_ENABLED=NO

# Wan software only; separate explicit approval/preparation is mandatory before enabling.
FILM_WAN_PAID_ENABLED=NO

# Hunyuan Community license is separate from cost consent. No real flag was enabled by Task 07.
FILM_HUNYUAN_PAID_ENABLED=NO
FILM_HUNYUAN_LICENSE_ACCEPTED=NO

# Task 08 software only. Audar and gated codec require independent reviewed permissions.
FILM_SPEECH_PAID_ENABLED=NO
FILM_AUDAR_LICENSE_ACCEPTED=NO
FILM_AUDAR_CODEC_LICENSE_ACCEPTED=NO

# Hierarchical OpenAI director: separate explicit text quote and wallet approval.
FILM_DIRECTOR_ENABLED=NO

# LatentSync: do not enable commercial use without actual face-weight rights.
FILM_LATENTSYNC_PAID_ENABLED=NO
FILM_LATENTSYNC_LICENSE_ACCEPTED=NO
FILM_LATENTSYNC_FACE_RIGHTS_APPROVED=NO
FILM_LATENTSYNC_RIGHTS_EVIDENCE=
