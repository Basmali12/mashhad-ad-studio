# Template only. Supply secret values privately; do not source examples into a live service.
FILM_DATA_DIR=/var/lib/iraq-ai-film-platform
FILM_DEDICATED_DATA_CONFIRMED=YES
FILM_DEPLOYMENT_ID=studio-film-staging-v1
FILM_PUBLIC_ORIGIN=https://127.0.0.1:3477
FILM_PORT=3477
FILM_TLS_CERT_FILE=/etc/iraq-ai-studio/film-tls/film-cert.pem
FILM_TLS_KEY_FILE=/etc/iraq-ai-studio/film-tls/film-key.pem
ENGINE_MASTER_KEY=
FILM_BRIDGE_SECRET=
ENGINE_DATABASE_DRIVER=postgres
ENGINE_DATABASE_HOST=127.0.0.1
ENGINE_DATABASE_PORT=5432
ENGINE_DATABASE_NAME=film_platform_staging
ENGINE_DATABASE_USER=film_platform_app
ENGINE_DATABASE_PASSWORD_FILE=/etc/iraq-ai-studio/film-database-password
# Customer metadata/drafts may be enabled only after explicit rental schema migration.
CUSTOMER_PLATFORM_ENABLED=YES
ENGINE_ALLOW_PAID_ACTIONS=NO
FILM_TEXT_ENABLED=NO
FILM_TEXT_ADMIN_BUDGET_MICRO_USD=0
FILM_LEGACY_ADMIN_ENABLED=NO
FILM_MEDIA_ORIGINS=
