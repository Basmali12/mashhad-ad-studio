# Private server file, outside the static document root. Never commit real values.
MASHHAD_FILM_GATEWAY_START=YES
MASHHAD_FILM_ENABLED=NO
MASHHAD_FILM_ORIGIN=https://iraqaistudio.com
MASHHAD_CONVEX_URL=https://your-existing-deployment.convex.cloud
MASHHAD_FILM_PORT=3480
# Reuse the existing internal film service origin and independently stored bridge key.
FILM_BACKEND_ORIGIN=
FILM_BRIDGE_SECRET=
# Optional exact old owner identity, server policy only. Never a customer fallback.
MASHHAD_FILM_LEGACY_OWNER_ID=
MASHHAD_FILM_LEGACY_OWNER_EMAIL=
# If the existing internal TLS uses a private CA, trust that exact existing CA.
# NODE_EXTRA_CA_CERTS=/etc/your-existing-film-ca.pem

# Public signed image origin; may differ from private HMAC backend transport.
FILM_PUBLIC_MEDIA_ORIGIN=https://studio.example.com
