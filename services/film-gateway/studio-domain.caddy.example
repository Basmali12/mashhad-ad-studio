# Target explicitly selected by the owner: https://iraqaistudio.com/.
# Template only: inspect existing TLS, headers, DNS and media routes first.
# GitHub Pages cannot serve /api/mashhad-film: activate the gateway and verify
# authenticated access before switching the root domain to this server.
# Preserve scan.iraqaistudio.com and all storage/worker routes.
iraqaistudio.com {
    handle /api/mashhad-film* {
        reverse_proxy 127.0.0.1:3480
    }
    handle_path /admin/* {
        root * /srv/mashhad-film/current/dist-admin
        try_files {path} /index.html
        file_server
    }
    handle /auth/* {
        respond 410
    }
    handle /api/* {
        respond 404
    }
    handle {
        root * /srv/mashhad-film/current/dist
        try_files {path} /index.html
        file_server
    }
}
